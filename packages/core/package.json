{
  "name": "@humanbehind/core",
  "version": "0.1.0",
  "description": "ABIs, signal encoding, groth16 proof packing and an anon-aadhaar prover for HumanBindingRegistry.",
  "keywords": [
    "erc-8004",
    "anon-aadhaar",
    "zero-knowledge",
    "groth16",
    "snarkjs"
  ],
  "license": "MIT",
  "author": "Agnij Dutta (https://x.com/0xholmesdev)",
  "homepage": "https://github.com/agnij-dutta/humanbehind/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agnij-dutta/humanbehind.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/agnij-dutta/humanbehind/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./prover": {
      "types": "./dist/prover.d.ts",
      "default": "./dist/prover.js"
    },
    "./testqr": {
      "types": "./dist/testqr.d.ts",
      "default": "./dist/testqr.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@anon-aadhaar/core": "2.4.3",
    "snarkjs": "^0.7.5",
    "viem": "^2.57.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~5.9.3"
  }
}
