{
  "name": "humanbehind",
  "version": "0.1.0",
  "private": true,
  "description": "Proof of Human Behind the Agent: a unique, adult Indian resident proves with anon-aadhaar that they own an ERC-8004 AI agent, revealing zero personal data.",
  "keywords": [
    "erc-8004",
    "anon-aadhaar",
    "zero-knowledge",
    "sybil-resistance",
    "ai-agents",
    "groth16",
    "proof-of-personhood"
  ],
  "license": "MIT",
  "author": "Agnij Dutta (https://x.com/0xholmesdev)",
  "homepage": "https://github.com/agnij-dutta/humanbehind#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agnij-dutta/humanbehind.git"
  },
  "bugs": {
    "url": "https://github.com/agnij-dutta/humanbehind/issues"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build:packages": "pnpm --filter @humanbehind/core --filter @humanbehind/verifier build",
    "abi": "node scripts/export-abi.mjs",
    "test:contracts": "cd contracts && forge test",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm build:packages && pnpm --filter web build",
    "fixture": "tsx scripts/prove-fixture.ts",
    "e2e": "tsx scripts/e2e-anvil.ts",
    "dev": "pnpm --filter web dev",
    "test:packages": "pnpm --filter @humanbehind/core --filter @humanbehind/verifier test",
    "test": "pnpm test:packages && pnpm test:contracts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write . && cd contracts && forge fmt",
    "format:check": "prettier --check . && cd contracts && forge fmt --check",
    "artifacts": "node scripts/fetch-artifacts.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@next/eslint-plugin-next": "16.3.8",
    "@types/node": "^22.10.0",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
