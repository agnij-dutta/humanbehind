# Human Behind the Agent: every environment variable, with comments. No real values.
#
# Web app: copy to apps/web/.env.local (Next.js reads env from apps/web).
# `pnpm tsx scripts/deploy.ts` writes apps/web/.env.local for you on a local anvil.

# --- apps/web (NEXT_PUBLIC_* is baked into the client bundle; never put secrets there) ---
# Chain the registries live on. 31337 = anvil.
NEXT_PUBLIC_CHAIN_ID=31337
# JSON-RPC endpoint the browser and server read from. Use a keyless public RPC
# or a local node; anything in NEXT_PUBLIC_* is visible to every visitor.
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
# ERC-8004 identity registry (agent NFTs).
NEXT_PUBLIC_IDENTITY_REGISTRY=0x0000000000000000000000000000000000000000
# HumanBindingRegistry. The trust anchor (test vs UIDAI key) is read from this
# contract on-chain; no env var or client flag selects it.
NEXT_PUBLIC_BINDING_REGISTRY=0x0000000000000000000000000000000000000000
# Where the browser fetches the circuit wasm/zkey/vkey. Default: the anon-aadhaar S3 bucket.
# Set to /artifacts after `pnpm --filter web link-artifacts` to serve them locally.
NEXT_PUBLIC_ARTIFACTS_BASE=/artifacts
# UI-only: shows the "Mint TEST QR" button and the anvil dev wallet. Grants nothing.
NEXT_PUBLIC_DEV_MODE=false
# Server-only: enables POST /api/dev/test-qr (mints QRs signed with the PUBLIC
# test key). The route also refuses to serve against a production-anchored registry.
HB_DEV_MODE=false
# Optional: alternate Next.js build dir (lets a second build run beside a live dev server).
NEXT_DIST_DIR=.next

# --- scripts/deploy.ts ---
# RPC to deploy to. Uses anvil's public dev key #0, so local chains only.
RPC_URL=http://127.0.0.1:8545

# --- contracts/script/Deploy.s.sol (forge script; all optional) ---
# Reuse an existing ERC-8004 identity registry instead of deploying one.
IDENTITY_REGISTRY=
# Reuse an existing anon-aadhaar verifier (its anchor must be the test key).
ANON_AADHAAR=
# Live agents one human may back. Default 3.
MAX_AGENTS=3

# --- scripts/browser-e2e.mjs ---
# Web app URL to drive.
BASE=http://localhost:3100
# Directory for screenshots and console logs.
OUT=.
# Path to a Chromium executable (e.g. Playwright's "Google Chrome for Testing").
CHROME=
